# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Roblox Open Cloud API key (Creator Dashboard -> Open Cloud -> API Keys).
# Scopes needed, on your universe: see README "Open Cloud API key".
ROBLOX_API_KEY=

# Optional: auto-link players who verified with Bloxlink or RoVer (set
# autoLink.provider in config.json). Bloxlink: Server API key from the Bloxlink
# dashboard (Developer). RoVer: run /api-key in your server with RoVer.
BLOXLINK_API_KEY=
ROVER_API_KEY=
