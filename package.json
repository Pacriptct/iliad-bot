{
  "name": "iliiad-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot for Odyssey: game logs, staff tools, rank sync, PD announcements and messenger pigeons.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "deploy-commands": "node --env-file-if-exists=.env dist/deploy-commands.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup-roles": "node --env-file-if-exists=.env dist/setup-roles.js",
    "peek": "node --env-file-if-exists=.env dist/peek.js"
  },
  "dependencies": {
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
